<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:uPowerMonitoring.ViewModels"
        xmlns:views="using:uPowerMonitoring.Views" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="uPowerMonitoring.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="uPowerMonitoring">

    <!-- Statt nur einer TextBox binden wir hier das Dashboard ein -->
    <views:DashBoard Grid.Row="1" DataContext="{Binding DashBoardViewModel}" />

</Window>
